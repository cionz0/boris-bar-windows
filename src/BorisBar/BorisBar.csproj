<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\fish.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>BorisBar</RootNamespace>
    <AssemblyName>BorisBar</AssemblyName>
    <Version>0.1.1</Version>
    <InformationalVersion>0.1.1</InformationalVersion>
    <Authors>Vincenzo Roselli</Authors>
    <Product>Boris Bar</Product>
    <Description>Windows tray soundboard inspired by the Italian TV series Boris. No audio files are redistributed.</Description>
    <NeutralLanguage>it</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\assets\fish.ico" Link="assets\fish.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\fish.png" Link="assets\fish.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\DISCLAIMER.txt" Link="DISCLAIMER.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
